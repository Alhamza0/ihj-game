# عنوان خادم اللعبة. في التطوير المحلي اتركه فارغاً ليستخدم localhost:3001.
# عند النشر ضع عنوان الخادم المنشور، مثال:
# VITE_SERVER_URL=https://ihj-server.onrender.com
VITE_SERVER_URL=

# Supabase (الحسابات + الليدربورد) — اتركهما فارغين للّعب كضيف بلا حسابات.
# انظر SUPABASE_SETUP.md. لا تضع مفتاح service_role هنا إطلاقاً (للخادم فقط).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
