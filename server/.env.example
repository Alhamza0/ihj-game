# منفذ الخادم (Render يضبطه تلقائياً)
PORT=3001
# أصل الواجهة المسموح (CORS). للتطوير اتركه * ؛ للإنتاج ضع دومين الواجهة.
CLIENT_ORIGIN=*

# Supabase (الحسابات + الليدربورد) — اتركهما فارغين للّعب كضيف بلا حفظ.
# انظر SUPABASE_SETUP.md. مفتاح service_role سرّي — للخادم فقط، لا يُوضع في الواجهة.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
